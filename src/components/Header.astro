---
// src/components/Header.astro
---
<header class="fixed top-0 z-50 w-full bg-black/40 backdrop-blur-md border-b border-white/10">
    <div class="relative flex justify-between items-center mx-auto px-6 py-4 xl:w-[1120px]">
        <!-- Logo o tu marca -->
        <a href="#top" class="font-bold text-lg text-white">root.narciso</a>

        <!-- Botón de Menú Hamburguesa (Móvil) -->
        <button id="menu-btn" class="md:hidden text-white focus:outline-none p-2" aria-label="Abrir menú">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

        <!-- Enlaces de navegación -->
        <nav id="menu-items" class="absolute top-full left-0 w-full bg-neutral-950/95 backdrop-blur-lg flex flex-col p-6 gap-y-4 border-b border-white/10 shadow-2xl md:static md:flex-row md:w-auto md:bg-transparent md:backdrop-blur-none md:p-0 md:gap-x-8 md:border-none md:shadow-none transition-all duration-300 ease-out opacity-0 pointer-events-none -translate-y-4 md:opacity-100 md:pointer-events-auto md:translate-y-0">
            <a href="#top" class="hover:text-blue-400 transition py-1">Inicio</a>
            <a href="#sobre-mi" class="hover:text-blue-400 transition py-1">Sobre mí</a>
            <a href="#experiencia" class="hover:text-blue-400 transition py-1">Experiencia</a>
            <a href="#proyectos" class="hover:text-blue-400 transition py-1">Proyectos</a>
            <a href="#habilidades" class="hover:text-blue-400 transition py-1">Habilidades</a>
            <a href="#contacto" class="hover:text-blue-400 transition py-1">Contacto</a>
        </nav>
    </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-items');

  // Función para abrir/cerrar el menú
  const toggleMenu = () => {
    menu?.classList.toggle('opacity-0');
    menu?.classList.toggle('pointer-events-none');
    menu?.classList.toggle('-translate-y-4');
    menu?.classList.toggle('opacity-100');
    menu?.classList.toggle('pointer-events-auto');
    menu?.classList.toggle('translate-y-0');
  };

  // Clic en la hamburguesa
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMenu();
  });

  // Ocultar al hacer clic en un enlace (Móvil)
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 768 && menu?.classList.contains('opacity-100')) {
        toggleMenu();
      }
    });
  });

  // Ocultar al hacer clic fuera del menú
  document.addEventListener('click', (e) => {
    if (window.innerWidth < 768) {
      const isClickInsideMenu = menu?.contains(e.target);
      const isClickOnButton = btn?.contains(e.target);

      // Si el clic es afuera y el menú está visible (opacidad 100)
      if (!isClickInsideMenu && !isClickOnButton && menu?.classList.contains('opacity-100')) {
        toggleMenu();
      }
    }
  });
</script>