---

{
    PROJECTS.map(({ title, description, link_repo, link_demo, images, tags }, projectIdx) => (
        <article class={projectIdx === PROJECTS.length - 1 ? '' : 'mb-12 pb-8 border-b border-white/10'}>
            <h3 class="text-2xl font-semibold text-blue-400 mb-2">{title}</h3>
            <p class="text-lg mb-4 text-pretty text-gray-300">{description}</p>
            
            <!-- Carrusel Normal (Miniatura) -->
            <div class="relative group mb-4">
                {images.length > 1 && (
                    <button onclick={`scrollCarousel('carousel-${projectIdx}', -1)`} class="hidden md:flex absolute left-3 top-1/2 -translate-y-1/2 z-10 bg-black/70 hover:bg-black text-white rounded-full p-2 border border-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 items-center justify-center w-10 h-10 shadow-lg">❮</button>
                )}
                {images.length > 1 && (
                    <button onclick={`scrollCarousel('carousel-${projectIdx}', 1)`} class="hidden md:flex absolute right-3 top-1/2 -translate-y-1/2 z-10 bg-black/70 hover:bg-black text-white rounded-full p-2 border border-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 items-center justify-center w-10 h-10 shadow-lg">❯</button>
                )}

                <div id={`carousel-${projectIdx}`} class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-lg scrollbar-none" style="scrollbar-width: none; -ms-overflow-style: none;">
                    {images.map((img, idx) => (
                        <div class="snap-start shrink-0 w-full relative">
                            <Image 
                                class="rounded-lg shadow-2xl border border-white/10 object-contain w-full h-auto max-h-[280px] md:max-h-[500px] bg-black/40 cursor-zoom-in hover:opacity-95 transition"
                                src={img} 
                                alt={`Captura ${idx + 1} de ${title}`}
                                loading="lazy"
                                onclick={`openLightbox('lightbox-${projectIdx}')`}
                            />
                        </div>
                    ))}
                </div>
                {images.length > 1 && (
                    <span id={`counter-${projectIdx}`} class="text-xs text-gray-400 mt-2 block text-right font-mono" data-total={images.length}>1 / {images.length} — Desliza o usa flechas</span>
                )}
            </div>

            <!-- Modal Lightbox Fullscreen -->
            <dialog 
                id={`lightbox-${projectIdx}`} 
                class="bg-transparent p-0 m-auto w-[100vw] h-[100vh] max-w-none max-h-none backdrop:bg-black/70 backdrop:backdrop-blur-md overflow-hidden"
                onclick={`if(event.target === this) closeLightbox('lightbox-${projectIdx}')`}
            >
                <button 
                    onclick={`closeLightbox('lightbox-${projectIdx}')`}
                    class="fixed top-4 right-4 md:top-6 md:right-6 bg-black/50 hover:bg-black/80 text-white rounded-full p-2 z-[-60] w-10 h-10 flex items-center justify-center font-bold text-xl transition shadow-lg border border-white/20"
                >
                    ✕
                </button>

                {images.length > 1 && (
                    <button onclick={`scrollLightbox('lightbox-carousel-${projectIdx}', -1)`} class="fixed left-2 md:left-6 top-1/2 -translate-y-1/2 z-50 bg-black/50 hover:bg-black/80 text-white rounded-full p-3 transition items-center justify-center w-10 h-10 md:w-12 md:h-12 shadow-lg hidden md:flex border border-white/20" aria-label="Imagen anterior">❮</button>
                )}
                {images.length > 1 && (
                    <button onclick={`scrollLightbox('lightbox-carousel-${projectIdx}', 1)`} class="fixed right-2 md:right-6 top-1/2 -translate-y-1/2 z-50 bg-black/50 hover:bg-black/80 text-white rounded-full p-3 transition items-center justify-center w-10 h-10 md:w-12 md:h-12 shadow-lg hidden md:flex border border-white/20" aria-label="Imagen siguiente">❯</button>
                )}
                {images.length > 1 && (
                    <span id={`lightbox-counter-${projectIdx}`} class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-black/50 text-white text-xs font-mono px-3 py-1.5 rounded-full border border-white/20" data-total={images.length}>1 / {images.length}</span>
                )}
                
                <div 
                    id={`lightbox-carousel-${projectIdx}`}
                    class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth w-full h-full items-center scrollbar-none"
                    style="scrollbar-width: none; -ms-overflow-style: none;"
                    onclick={`if(event.target === this) closeLightbox('lightbox-${projectIdx}')`}
                >
                    {images.map((img, idx) => (
                        <div 
                            class="snap-center shrink-0 w-full h-full flex items-center justify-center p-4 md:p-20 relative"
                            onclick={`if(event.target === this) closeLightbox('lightbox-${projectIdx}')`}
                        >
