                                class="max-w-full max-h-full object-contain rounded-xl shadow-2xl cursor-zoom-out"
                                src={img} 
                                alt={`Vista ampliada ${idx + 1} de ${title}`} 
                                onclick={`closeLightbox('lightbox-${projectIdx}')`}
                            />
                        </div>
                    ))}
                </div>
            </dialog>

            <!-- Tags -->
            <ul class="flex gap-x-2 flex-wrap mb-4">
                {tags.map((tag) => (
                    <li>
                        <span class={`flex gap-x-2 ${tag.class} rounded-full text-xs py-1 px-2.5 mb-2 items-center font-medium`}>
                            {tag.icon && <tag.icon class="size-4" />}
                            {tag.name}
                        </span>
                    </li>
                ))}
            </ul>

            <!-- Contenedor de Botones (Condicionales con link_repo y link_demo) -->
            <div class="flex flex-wrap gap-3 mt-4">
                {link_repo && (
                    <a 
                        target="_blank"
                        rel="noopener noreferrer"
                        href={link_repo}
                        class="inline-flex items-center gap-x-2 border border-white/20 bg-white/10 hover:bg-white/20 hover:scale-105 transition font-medium rounded-lg text-sm px-4 py-2 h-9"
                    >
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                        Ver código
                    </a>
                )}
                
                {link_demo && (
                    <a 
                        target="_blank"
                        rel="noopener noreferrer"
                        href={link_demo}
                        class="inline-flex items-center gap-x-2 border border-blue-400/30 bg-blue-500/10 hover:bg-blue-500/20 hover:scale-105 transition font-medium rounded-lg text-sm px-4 py-2 h-9 text-blue-300"
                    >
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        Ver demo
                    </a>
                )}
            </div>
        </article>
    ))
}

<script is:inline>
  function openLightbox(modalId) {
    const dialog = document.getElementById(modalId);
    if (dialog) {
        dialog.showModal();
        document.body.style.overflow = 'hidden'; 
    }
  }

  function closeLightbox(modalId) {
    const dialog = document.getElementById(modalId);
    if (dialog) {
        dialog.close();
        document.body.style.overflow = ''; 
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('dialog').forEach(dialog => {
        dialog.addEventListener('close', () => {
            document.body.style.overflow = '';
        });
    });

    // Agregar listeners de scroll a todos los carruseles (miniatura)
    document.querySelectorAll('[id^="carousel-"]').forEach(carousel => {
      let scrollTimeout;
      carousel.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => updateCarouselCounter(carousel.id), 50);
      });
    });

    // Agregar listeners de scroll a todos los carruseles del lightbox
    document.querySelectorAll('[id^="lightbox-carousel-"]').forEach(carousel => {
      let scrollTimeout;
      carousel.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => updateLightboxCounter(carousel.id), 50);
      });
    });
  });

  function scrollCarousel(carouselId, direction) {
    const container = document.getElementById(carouselId);
    if (!container) return;
    
    const scrollAmount = container.clientWidth;
    container.scrollBy({
      left: direction * scrollAmount,
      behavior: 'smooth'
    });
    
    // Actualizar contador después del scroll suave
    setTimeout(() => updateCarouselCounter(carouselId), 350);
  }

  function scrollLightbox(carouselId, direction) {
    const container = document.getElementById(carouselId);
    if (!container) return;
    
    const scrollAmount = container.clientWidth;
    container.scrollBy({
      left: direction * scrollAmount,
      behavior: 'smooth'
    });
    
    // Actualizar contador del lightbox después del scroll suave
    setTimeout(() => updateLightboxCounter(carouselId), 350);
  }

  function updateCarouselCounter(carouselId) {
    const container = document.getElementById(carouselId);
    if (!container) return;
    
    const projectIdx = carouselId.replace('carousel-', '');
    const counterEl = document.getElementById(`counter-${projectIdx}`);
    if (!counterEl) return;
    
    const total = parseInt(counterEl.dataset.total, 10);
    const scrollLeft = container.scrollLeft;
    const itemWidth = container.clientWidth;
    const currentIndex = Math.round(scrollLeft / itemWidth);
    const clampedIndex = Math.max(0, Math.min(currentIndex, total - 1));
    
    counterEl.textContent = `${clampedIndex + 1} / ${total} — Desliza o usa flechas`;
  }

  function updateLightboxCounter(carouselId) {
    const container = document.getElementById(carouselId);
    if (!container) return;
    
    const projectIdx = carouselId.replace('lightbox-carousel-', '');
    const counterEl = document.getElementById(`lightbox-counter-${projectIdx}`);
    if (!counterEl) return;
    
    const total = parseInt(counterEl.dataset.total, 10);
    const scrollLeft = container.scrollLeft;
    const itemWidth = container.clientWidth;
    const currentIndex = Math.round(scrollLeft / itemWidth);
    const clampedIndex = Math.max(0, Math.min(currentIndex, total - 1));
    
    counterEl.textContent = `${clampedIndex + 1} / ${total}`;
  }
</script>