        description: 'Infraestructura self-hosted en Raspberry Pi 5 con NVMe. Docker, Pi-hole, Tailscale, n8n, Nextcloud y control de contenedores vía Telegram. Acceso remoto sin exponer puertos.',
        link: 'https://github.com/NarcisoIn/pi-homelab',
        images: ['/src/assets/projects/pi-hole.webp'],
        tags: [TAGS.LINUX, TAGS.DOCKER, TAGS.RASPBERRY_PI, TAGS.PIHOLE, TAGS.NEXTCLOUD, TAGS.TAILSCALE, TAGS.N8N],
    },
    {
        title: 'AuxiDrive',
        description: 'App móvil que conecta propietarios de vehículos con mecánicos. Chat cifrado AES-256, mapa con OpenStreetMap, gestión de solicitudes con estados, cotizaciones y calificaciones. Backend serverless con Cloud Functions.',
        images: ['/src/assets/projects/AuxiDrive_login.webp','/src/assets/projects/AuxiDrive_singup.webp' , '/src/assets/projects/AuxiDrive_feed.webp', '/src/assets/projects/AuxiDrive_perfil.webp', '/src/assets/projects/AuxiDrive_servicios.webp', '/src/assets/projects/AuxiDrive_busqueda.webp', '/src/assets/projects/AuxiDrive_solicitud_servicio.webp'],
