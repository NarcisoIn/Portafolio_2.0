---
const { date, title, description, link } = Astro.props;
---
<div class="absolute w-3 h-3 bg-white rounded-full mt-1.5 -inset-s-1.5 border border-gray-600"></div
>
<time class="text-sm font-normal leading-none text-body opacity-80">
    {date}
</time>
<h3 class="text-lg font-semibold text-heading my-2 text-blue-600/80">
    {title}
</h3>
<p class="mb-4 text-base font-normal text-body text-pretty">
    {description}
</p>

{
    link && (
        <a 
        target="_blank"
        rel="noopener noreferrer"
        href={link}
            class="inline-flex items-center gap-x-1.5 border border-white/20 bg-white/10 hover:bg-white/15 hover:scale-105 transition font-medium rounded-lg text-sm px-3 py-2 h-8"
        >
        Ver repositorio... 
        </a>
    )
}
