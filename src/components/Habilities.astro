import Tailwind from "./icons/Tailwind.astro"
import HTML from "./icons/HTML.astro"
import CSS from "./icons/CSS.astro"
import PostgreSQL from "./icons/PostgreSQL.astro"

const TAGS = {
    LINUX: {
        name: 'Linux',
        class: 'bg-[#3a3a3a] text-white hover:scale-105 transition', // gris carbón, Tux (amarillo/blanco) resalta
        icon: Linux,
    },
    DOCKER: {
        name: 'Docker',
        class: 'bg-[#003159] text-white hover:scale-105 transition', // el tuyo, perfecto
        icon: Docker,
    },
    RASPBERRY_PI: {
        name: 'Raspberry Pi',
        class: 'bg-[#46091F] text-white hover:scale-105 transition', // frambuesa oscuro (marca #C51A4A)
        icon: RaspberryPi,
    },
    PIHOLE: {
        name: 'Pi-hole',
        class: 'bg-[#350808] text-white hover:scale-105 transition', // rojo casi negro
        icon: PiHole,
    },
    TAILSCALE: {
    name: 'Tailscale',
    class: 'bg-[#243C5A] text-white hover:scale-105 transition',
    icon: Tailscale,
    },
    NEXTCLOUD: {
        name: 'Nextcloud',
        class: 'bg-[#00344F] text-white hover:scale-105 transition', // azul oscuro (marca #0082C9)
        icon: Nextcloud,
    },
    TELEGRAM: {
        name: 'Telegram',
        class: 'bg-[#0D3A52] text-white hover:scale-105 transition', // azul cielo oscuro (marca #26A5E4)
        icon: Telegram,
    },
    N8N: {
        name: 'n8n',
        class: 'bg-[#471423] text-white hover:scale-105 transition', // vino (marca #EA4B71)
        icon: n8n,
    },
    PYTHON: {
        name: 'Python',
        class: 'bg-[#14385C] text-white hover:scale-105 transition', // azul Python oscuro (#3776AB)
        icon: Python,
    },
    FLUTTER: {
        name: 'Flutter',
        class: 'bg-[#032E5B] text-white hover:scale-105 transition', // azul Flutter oscuro (#02569B)
        icon: Flutter,
    },
    FIREBASE: {
        name: 'Firebase',
        class: 'bg-[#3F2A00] text-white hover:scale-105 transition', // ámbar oscuro (marca #FFCA28)
        icon: Firebase,
    },
    DART: {
        name: 'Dart',
        class: 'bg-[#003C4A] text-white hover:scale-105 transition', // teal oscuro (marca #00C4B3)
        icon: Dart,
    },
    NODEJS: {
        name: 'Node.js',
        class: 'bg-[#11301C] text-white hover:scale-105 transition', // verde bosque (marca #339933)
        icon: NodeJS,
    },
    MYSQL: {
        name: 'MySQL',
        class: 'bg-[#003A47] text-white hover:scale-105 transition', // teal MySQL oscuro (#00758F)
        icon: MySQL,
    },
    EXCEL: {
        name: 'Excel',
        class: 'bg-[#0C3A22] text-white hover:scale-105 transition', // verde Excel oscuro (#217346)
        icon: Excel,
    },
    VLAN: {
        name: 'VLAN',
        class: 'bg-[#1E293B] text-white hover:scale-105 transition', // slate neutro, los 3 nodos de color resaltan
        icon: VLAN,
    },
    VLSM: {
        name: 'VLSM',
        class: 'bg-[#102A43] text-white hover:scale-105 transition', // azul grisáceo, combina con el globo
        icon: VLSM,
    },
    TKINTER: {
        name: 'Tkinter',
        class: 'bg-[#233142] text-white hover:scale-105 transition', // azul pizarra neutro
        icon: Tkinter,
    },
    NUMPY: {
        name: 'NumPy',
        class: 'bg-[#13294B] text-white hover:scale-105 transition', // navy (marca #4D77CF)
        icon: Numpy,
    },
    MATPLOTLIB: {
        name: 'Matplotlib',
        class: 'bg-[#262626] text-white hover:scale-105 transition', // neutro oscuro, las cuñas de colores brillan
        icon: Matplotlib,
    },
    YFINANCE: {
        name: 'yfinance',
        class: 'bg-[#2E1065] text-white hover:scale-105 transition', // morado profundo (barras #A855F7)
        icon: Yfinance,
    },
    CISCO: {
        name: 'Cisco',
        class: 'bg-[#04364A] text-white hover:scale-105 transition', // azul Cisco oscuro (#049FD9)
        icon: Cisco,
    },
    ASTRO: {
    name: 'Astro',
    class: 'bg-[#17072B] text-white hover:scale-105 transition', // morado muy oscuro (marca #BC52EE)
    icon: AstroIcon,
    },
    TAILWIND: {
        name: 'Tailwind',
        class: 'bg-[#0C3D4A] text-white hover:scale-105 transition', // teal oscuro (marca #06B6D4)
        icon: Tailwind,
    },
    HTML: {
        name: 'HTML',
        class: 'bg-[#4A1A0A] text-white hover:scale-105 transition', // naranja muy oscuro (marca #E34F26)
        icon: HTML,
    },
    CSS: {
        name: 'CSS',
        class: 'bg-[#0A1A4A] text-white hover:scale-105 transition', // azul muy oscuro (marca #2965F1)
        icon: CSS,
    },
    POSTGRESQL: {
        name: 'PostgreSQL',
        class: 'bg-[#1A3347] text-white hover:scale-105 transition', // azul grisáceo oscuro (marca #336791)
        icon: PostgreSQL,
    }
}


const HABILITIES = [
    {
        title: 'Infraestructura & Sistemas',
        tags: [TAGS.LINUX, TAGS.DOCKER, TAGS.RASPBERRY_PI, TAGS.PIHOLE, TAGS.NEXTCLOUD, TAGS.TAILSCALE, TAGS.N8N],
    },
    {
        title: 'Redes',
        tags: [TAGS.CISCO, TAGS.VLAN, TAGS.VLSM],
    },
    {
        title: 'Desarrollo',
        tags: [TAGS.PYTHON, TAGS.FLUTTER, TAGS.DART, TAGS.NODEJS, TAGS.FIREBASE],
    },
    {
        title: 'Bases de Datos',
        tags: [TAGS.MYSQL, TAGS.POSTGRESQL],
    },
    {
        title: 'Análisis de Datos',
        tags: [TAGS.NUMPY, TAGS.MATPLOTLIB, TAGS.YFINANCE, TAGS.TKINTER],
    },
    {
        title: 'Web',
        tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.HTML, TAGS.CSS],
    },
]
---
<div class="grid md:grid-cols-2 gap-4">
{
    HABILITIES.map(({title, tags}) => (

        <article class="border border-white/10 rounded-xl p-6 bg-white/5 mb-5">
            <h3 class="text-xl font-semibold  text-blue-600/80 mb-4">{title}</h3>
            <ul class="flex gap-x-2 flex-wrap">
                {tags.map((tag) => (
                    <li>
                        <span 
                        class={`flex gap-x-2 ${tag.class} rounded-full text-xs py-1 px-2 mb-2 items-center`}
                        >
                            {tag.icon && <tag.icon class="size-5" />}
                            {tag.name}
                        </span>
                    </li>
                ))}
            </ul>
        </article>
    ))
}
</div>
