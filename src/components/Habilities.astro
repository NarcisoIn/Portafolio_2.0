const HABILITIES = [
    {
        title: 'Infraestructura & Sistemas',
        tags: [TAGS.LINUX, TAGS.FEDORA, TAGS.UBUNTU, TAGS.DOCKER, TAGS.PORTAINER, TAGS.RASPBERRY_PI, TAGS.PIHOLE, TAGS.NEXTCLOUD, TAGS.TAILSCALE, TAGS.N8N, TAGS.BASH],
    },
    {
        title: 'Redes',
        tags: [TAGS.CISCO, TAGS.VLAN, TAGS.VLSM, TAGS.CLOUDFLARE, TAGS.GNS3],
    },
    {
        title: 'Desarrollo',
        tags: [TAGS.PYTHON, TAGS.JAVA, TAGS.JS, TAGS.FASTAPI, TAGS.FLASK, TAGS.ARDUINO, TAGS.OLLAMA, TAGS.FIREBASE, TAGS.GIT],
    },
    {
        title: 'Bases de Datos',
        tags: [TAGS.MYSQL, TAGS.POSTGRESQL],
    },
    {
        title: 'Análisis de Datos',
        tags: [TAGS.NUMPY, TAGS.MATPLOTLIB, TAGS.YFINANCE, TAGS.TKINTER],
