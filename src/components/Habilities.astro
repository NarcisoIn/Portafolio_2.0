---
import Linux from "./icons/Linux.astro"
import Docker from "./icons/Docker.astro"
import RaspberryPi from "./icons/RaspberryPi.astro"
import Tailscale from "./icons/Tailscale.astro"
import Nextcloud from "./icons/Nextcloud.astro"
import Telegram from "./icons/Telegram.astro"
import PiHole from "./icons/Pi-Hole.astro"
import n8n from "./icons/n8n.astro"
import Python from "./icons/Python.astro"
import Flutter from "./icons/Flutter.astro"
import Firebase from "./icons/Firebase.astro"
import NodeJS from "./icons/NodeJS.astro"
import Dart from "./icons/Dart.astro"
import MySQL from "./icons/MySQL.astro"
import Excel from "./icons/Excel.astro"
import VLAN from "./icons/VLAN.astro"
import VLSM from "./icons/VLSM.astro"
import Tkinter from "./icons/Tkinter.astro"
import Numpy from "./icons/Numpy.astro"
import Matplotlib from "./icons/Matplotlib.astro"
import Yfinance from "./icons/Yfinance.astro"
import Cisco from "./icons/Cisco.astro"
